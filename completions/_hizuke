(( $+functions[_hizuke_commands] )) ||
_hizuke_commands() {
    local commands; commands=(
'preview:Show a read-only plan, without questions or filesystem writes' \
'plan:Show a read-only plan, without questions or filesystem writes' \
'apply:Review, ask about duplicates, and apply recoverable changes' \
'rename:Review, ask about duplicates, and apply recoverable changes' \
'undo:Preview and restore original names from a completed transaction' \
'recover:Preview and restore original names after an interrupted operation' \
'history:Read transaction history; --transaction shows the exact file mapping' \
'completions:Generate shell completions to standard output' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'hizuke commands' commands "$@"
}
